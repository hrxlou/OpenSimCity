# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/
MemoryCaptures/
Recordings/

# Editor-session artifacts: local package/render-debugger state, not shared config
ProjectSettings/PackageManagerSettings.asset
ProjectSettings/URPProjectSettings.asset

# IDE generated
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Test/build output
TestResults/
Artifacts/
*.apk
*.aab
*.app

# OS files
.DS_Store
Thumbs.db

# Local environment
.env
.env.*
!.env.example

# Unity license files (never commit)
*.alf
*.ulf

# Unity PlayMode test runner leaves a temporary init scene in Assets/
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta

# Blender local working outputs and backup files
Blender/output/checkpoints/
Blender/output/review/
Blender/output/*.blend1
Blender/Source/**/*.blend1
Blender/Scripts/__pycache__/
Blender/References/
Blender/assets/
Blender/output/*.blend
