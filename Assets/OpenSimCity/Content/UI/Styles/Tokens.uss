/*
 * OpenSimCity design tokens.
 *
 * Colors mirror Docs/DESIGN.md section 3.2 and are the single source for runtime
 * UI. Screens must consume these variables instead of literal colors, spacing or
 * font sizes; UiTokenValidator fails the build when a token is missing or defined
 * twice.
 */

:root {
    /* Surfaces */
    --osc-color-canvas: #0D1115;
    --osc-color-panel: rgba(29, 32, 35, 0.97);
    --osc-color-elevated: rgba(43, 47, 50, 0.98);
    --osc-color-border: #50575B;

    /* Text */
    --osc-color-text-primary: #F2F4F5;
    --osc-color-text-secondary: #AAB2B9;

    /* Status and emphasis */
    --osc-color-accent: #83C7C2;
    --osc-color-info: #86B9D8;
    --osc-color-success: #7DBB83;
    --osc-color-warning: #D7AD63;
    --osc-color-danger: #D97872;
    --osc-color-special: #A995C4;

    /*
     * State layers composited over the surface tokens. Kept separate from the
     * status colors so hover/selected feedback never reads as a warning.
     */
    --osc-state-hover: rgba(98, 168, 209, 0.12);
    --osc-state-selected: rgba(98, 168, 209, 0.22);
    --osc-state-disabled-opacity: 0.38;
    --osc-state-focus-ring: var(--osc-color-accent);
    --osc-state-focus-ring-width: 2px;

    /* Spacing scale, 4px base */
    --osc-space-0: 0;
    --osc-space-1: 4px;
    --osc-space-2: 8px;
    --osc-space-3: 12px;
    --osc-space-4: 16px;
    --osc-space-5: 24px;
    --osc-space-6: 32px;

    /* Border and radius */
    --osc-border-width: 1px;
    --osc-radius-sm: 0;
    --osc-radius-md: 0;
    --osc-radius-lg: 0;

    /*
     * Type scale. Values are the 100% UI scale baseline; PanelSettings scales
     * them for 125% and 150%. P3-06 records the default Korean fallback without
     * bundling a font asset, so only the scale and fallback behaviour are fixed here.
     */
    --osc-font-size-caption: 13px;
    --osc-font-size-body: 15px;
    --osc-font-size-body-strong: 16px;
    --osc-font-size-title: 20px;
    --osc-font-size-display: 28px;

    /* Layout slots from Docs/DESIGN.md section 3.3 */
    --osc-tool-rail-width: 132px;
    --osc-build-palette-height: 58px;
    --osc-context-inspector-width: 320px;
}
